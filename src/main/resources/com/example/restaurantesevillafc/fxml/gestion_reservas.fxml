<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantesevillafc.controller.GestionReservasController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="titulo" text="Gestión de reservas" />
                        <Label styleClass="subtitulo" text="Confirma o cancela las solicitudes de los clientes" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnConfirmar" accessibleText="Confirmar la reserva seleccionada y asignarle mesa" mnemonicParsing="false" onAction="#confirmar" styleClass="boton-principal" text="✓  Confirmar">
                    <tooltip>
                        <Tooltip text="Confirma la reserva seleccionada (pide confirmación)" />
                    </tooltip>
                </Button>
                <Button fx:id="btnCancelar" accessibleText="Cancelar la reserva seleccionada" mnemonicParsing="false" onAction="#cancelar" styleClass="boton-peligro" text="✕  Cancelar">
                    <tooltip>
                        <Tooltip text="Cancela la reserva seleccionada (pide confirmación)" />
                    </tooltip>
                </Button>
            </children>
        </HBox>
        <HBox spacing="12.0">
            <children>
                <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="subtitulo" text="Reservas hoy" />
                        <Label fx:id="lblHoy" styleClass="numero-resumen" text="0" />
                    </children>
                </VBox>
                <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="subtitulo" text="Pendientes" />
                        <Label fx:id="lblPendientes" styleClass="numero-resumen-amarillo" text="0" />
                    </children>
                </VBox>
                <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="subtitulo" text="Confirmadas" />
                        <Label fx:id="lblConfirmadas" styleClass="numero-resumen-verde" text="0" />
                    </children>
                </VBox>
                <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="subtitulo" text="Canceladas" />
                        <Label fx:id="lblCanceladas" styleClass="numero-resumen-rojo" text="0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="panel-formulario">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <DatePicker fx:id="dpFecha" accessibleText="Filtrar por día" prefWidth="140.0" promptText="Todos los días">
                    <tooltip>
                        <Tooltip text="Ver solo las reservas de un día" />
                    </tooltip>
                </DatePicker>
                <ComboBox fx:id="cmbEstado" accessibleText="Filtrar por estado" prefWidth="160.0" />
                <TextField fx:id="txtBuscar" accessibleText="Buscar por cliente, correo o número de reserva" onAction="#filtrar" promptText="Buscar cliente, correo o nº de reserva..." HBox.hgrow="ALWAYS" />
                <Button accessibleText="Aplicar los filtros" mnemonicParsing="false" onAction="#filtrar" styleClass="boton-filtrar" text="Filtrar" />
                <Button accessibleText="Quitar los filtros" mnemonicParsing="false" onAction="#limpiarFiltros" styleClass="boton-secundario" text="Limpiar" />
            </children>
        </HBox>
        <TableView fx:id="tablaReservas" accessibleText="Tabla de reservas de los clientes" styleClass="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colCliente" prefWidth="200.0" text="CLIENTE" />
                <TableColumn fx:id="colFecha" prefWidth="100.0" text="FECHA" />
                <TableColumn fx:id="colHora" prefWidth="70.0" text="HORA" />
                <TableColumn fx:id="colPersonas" prefWidth="80.0" text="PERSONAS" />
                <TableColumn fx:id="colMesa" prefWidth="70.0" text="MESA" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="ESTADO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label fx:id="lblObservaciones" maxWidth="Infinity" styleClass="nota-info" text="Selecciona una reserva para ver sus observaciones." wrapText="true" />
        <Label fx:id="lblError" managed="false" maxWidth="Infinity" styleClass="mensaje-error" visible="false" wrapText="true" />
    </children>
</VBox>
