<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantesevillafc.controller.GestionPedidosController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <VBox spacing="14.0" HBox.hgrow="ALWAYS">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="titulo" text="Gestión de pedidos" />
                        <Label styleClass="subtitulo" text="Sigue el estado de cada pedido en tiempo real" />
                    </children>
                </VBox>
                <HBox alignment="CENTER_LEFT" styleClass="selector-pestanas" maxWidth="-Infinity">
                    <children>
                        <ToggleButton fx:id="btnEnCurso" accessibleText="Ver los pedidos en curso" mnemonicParsing="false" onAction="#cambiarPestana" selected="true" styleClass="pestana" text="En curso">
                            <toggleGroup>
                                <ToggleGroup fx:id="grupoPestanas" />
                            </toggleGroup>
                            <graphic>
                                <Label fx:id="lblNumEnCurso" styleClass="badge-pestana" text="0" />
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="btnFinalizados" accessibleText="Ver los pedidos finalizados" mnemonicParsing="false" onAction="#cambiarPestana" styleClass="pestana" text="Finalizados" toggleGroup="$grupoPestanas">
                            <graphic>
                                <Label fx:id="lblNumFinalizados" styleClass="badge-pestana-gris" text="0" />
                            </graphic>
                        </ToggleButton>
                    </children>
                </HBox>
                <VBox spacing="10.0" styleClass="panel-formulario" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                    <children>
                        <TextField fx:id="txtBuscar" accessibleText="Buscar por número de pedido o cliente" promptText="Buscar por nº de pedido o cliente...">
                            <tooltip>
                                <Tooltip text="Escribe el número del pedido o el nombre del cliente" />
                            </tooltip>
                        </TextField>
                        <StackPane VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tablaPedidos" accessibleText="Tabla de pedidos" styleClass="tabla">
                                    <columns>
                                        <TableColumn fx:id="colNumero" prefWidth="70.0" text="Nº" />
                                        <TableColumn fx:id="colCliente" prefWidth="180.0" text="CLIENTE" />
                                        <TableColumn fx:id="colHora" prefWidth="70.0" text="HORA" />
                                        <TableColumn fx:id="colTotal" prefWidth="80.0" text="TOTAL" />
                                        <TableColumn fx:id="colEstado" prefWidth="120.0" text="ESTADO" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <ProgressIndicator fx:id="indicadorCarga" accessibleText="Cargando los pedidos" maxHeight="48.0" maxWidth="48.0" visible="false" />
                            </children>
                        </StackPane>
                        <Label maxWidth="Infinity" styleClass="nota-info" text="ⓘ  Los pedidos marcados como «Entregado» pasan automáticamente a la pestaña Finalizados." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </VBox>
        <VBox maxWidth="290.0" minWidth="260.0" prefWidth="280.0" spacing="8.0" styleClass="panel-formulario">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
                <Label fx:id="lblSinSeleccion" maxWidth="Infinity" styleClass="subtitulo" text="Selecciona un pedido de la tabla para ver su detalle." wrapText="true" />
                <VBox fx:id="panelDetalle" spacing="8.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox>
                            <children>
                                <Label fx:id="lblPedido" styleClass="titulo-formulario" text="Pedido #" />
                                <Label fx:id="lblInfoPedido" styleClass="subtitulo" />
                            </children>
                        </VBox>
                        <HBox fx:id="panelProgreso" alignment="TOP_CENTER">
                            <VBox.margin>
                                <Insets bottom="4.0" top="6.0" />
                            </VBox.margin>
                        </HBox>
                        <ScrollPane fitToWidth="true" prefHeight="120.0" styleClass="scroll-lineas" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="panelLineas" spacing="8.0" />
                            </content>
                        </ScrollPane>
                        <HBox alignment="CENTER_LEFT" styleClass="fila-total">
                            <children>
                                <Label styleClass="plato-nombre" text="Total" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalPedido" styleClass="total-pedido" />
                            </children>
                        </HBox>
                        <Label styleClass="etiqueta-campo" text="Observaciones" />
                        <Label fx:id="lblObservaciones" maxWidth="Infinity" styleClass="caja-observaciones" wrapText="true" />
                        <Label styleClass="etiqueta-campo" text="Estado del pedido" />
                        <ComboBox fx:id="cmbEstado" accessibleText="Nuevo estado del pedido" maxWidth="Infinity" promptText="Elige el estado" />
                        <Label fx:id="lblError" managed="false" maxWidth="Infinity" styleClass="mensaje-error" visible="false" wrapText="true" />
                        <Button fx:id="btnCambiarEstado" accessibleText="Cambiar el estado del pedido seleccionado" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#cambiarEstado" styleClass="boton-principal" text="✓  Cambiar estado">
                            <tooltip>
                                <Tooltip text="Guarda el nuevo estado del pedido (pide confirmación)" />
                            </tooltip>
                        </Button>
                        <Button accessibleText="Ver el ticket del pedido" maxWidth="Infinity" mnemonicParsing="false" onAction="#imprimirTicket" styleClass="boton-secundario" text="Imprimir ticket" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
