<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantesevillafc.controller.GestionMenuController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <VBox spacing="2.0">
            <children>
                <Label styleClass="titulo" text="Gestión del menú" />
                <Label styleClass="subtitulo" text="Añade, modifica o elimina platos de la carta" />
            </children>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <Button fx:id="btnAnadir" disable="true" mnemonicParsing="false" styleClass="boton-principal" text="+ Añadir plato">
                    <tooltip>
                        <Tooltip text="Próximamente" />
                    </tooltip>
                </Button>
                <Button fx:id="btnModificar" disable="true" mnemonicParsing="false" styleClass="boton-secundario" text="Modificar" />
                <Button fx:id="btnEliminar" disable="true" mnemonicParsing="false" styleClass="boton-peligro" text="Eliminar" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblResumen" styleClass="subtitulo" />
            </children>
        </HBox>
        <TableView fx:id="tablaPlatos" styleClass="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPlato" prefWidth="320.0" text="PLATO" />
                <TableColumn fx:id="colCategoria" prefWidth="140.0" text="CATEGORÍA" />
                <TableColumn fx:id="colPrecio" prefWidth="100.0" text="PRECIO" />
                <TableColumn fx:id="colEstado" prefWidth="130.0" text="ESTADO" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay platos en la carta" />
            </placeholder>
        </TableView>
        <Label fx:id="lblTotal" styleClass="subtitulo" />
    </children>
</VBox>
