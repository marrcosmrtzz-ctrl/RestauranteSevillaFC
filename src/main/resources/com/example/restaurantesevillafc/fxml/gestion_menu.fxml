<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantesevillafc.controller.GestionMenuController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <VBox spacing="14.0" HBox.hgrow="ALWAYS">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="titulo" text="Gestión del menú" />
                        <Label styleClass="subtitulo" text="Añade, modifica o elimina platos de la carta" />
                    </children>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Button fx:id="btnAnadir" minWidth="-Infinity" accessibleText="Añadir un plato nuevo" mnemonicParsing="false" onAction="#nuevoPlato" styleClass="boton-principal" text="+ Añadir plato">
                            <tooltip>
                                <Tooltip text="Vacía el formulario para crear un plato nuevo" />
                            </tooltip>
                        </Button>
                        <Button fx:id="btnModificar" minWidth="-Infinity" accessibleText="Modificar el plato seleccionado" mnemonicParsing="false" onAction="#modificarPlato" styleClass="boton-secundario" text="Modificar">
                            <tooltip>
                                <Tooltip text="Edita el plato seleccionado" />
                            </tooltip>
                        </Button>
                        <Button fx:id="btnEliminar" minWidth="-Infinity" accessibleText="Eliminar el plato seleccionado" mnemonicParsing="false" onAction="#eliminarPlato" styleClass="boton-peligro" text="Eliminar">
                            <tooltip>
                                <Tooltip text="Elimina el plato seleccionado (pide confirmación)" />
                            </tooltip>
                        </Button>
                        <Button fx:id="btnDeshacer" minWidth="-Infinity" accessibleText="Deshacer el último cambio" mnemonicParsing="false" onAction="#deshacer" styleClass="boton-secundario" text="↶">
                            <tooltip>
                                <Tooltip fx:id="tipDeshacer" text="Deshacer (Ctrl+Z)" />
                            </tooltip>
                        </Button>
                        <Button fx:id="btnRehacer" minWidth="-Infinity" accessibleText="Rehacer el último cambio deshecho" mnemonicParsing="false" onAction="#rehacer" styleClass="boton-secundario" text="↷">
                            <tooltip>
                                <Tooltip fx:id="tipRehacer" text="Rehacer (Ctrl+Y)" />
                            </tooltip>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblResumen" styleClass="subtitulo" />
                    </children>
                </HBox>
                <TableView fx:id="tablaPlatos" accessibleText="Tabla de platos de la carta" styleClass="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPlato" prefWidth="260.0" text="PLATO" />
                        <TableColumn fx:id="colCategoria" prefWidth="110.0" text="CATEGORÍA" />
                        <TableColumn fx:id="colPrecio" prefWidth="80.0" text="PRECIO" />
                        <TableColumn fx:id="colEstado" prefWidth="110.0" text="ESTADO" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No hay platos en la carta" />
                    </placeholder>
                </TableView>
                <Label fx:id="lblTotal" styleClass="subtitulo" />
            </children>
        </VBox>
        <VBox maxWidth="260.0" minWidth="240.0" prefWidth="250.0" spacing="6.0" styleClass="panel-formulario">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="titulo-formulario" text="Datos del plato" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblModo" styleClass="etiqueta-modo" text="Nuevo" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="6.0" />
                    </VBox.margin>
                </HBox>
                <StackPane prefHeight="120.0" styleClass="caja-foto">
                    <children>
                        <Label fx:id="lblSinFoto" styleClass="subtitulo" text="Sin foto" />
                        <ImageView fx:id="imgFoto" fitHeight="120.0" fitWidth="218.0" pickOnBounds="true" preserveRatio="true" />
                        <Button fx:id="btnFoto" accessibleText="Elegir la foto del plato" mnemonicParsing="false" onAction="#elegirFoto" styleClass="boton-foto" text="📷 Elegir foto" StackPane.alignment="BOTTOM_RIGHT">
                            <tooltip>
                                <Tooltip text="Elige una imagen JPG o PNG de tu ordenador (máx. 5 MB). Se guarda al pulsar Guardar" />
                            </tooltip>
                            <StackPane.margin>
                                <Insets bottom="6.0" right="6.0" />
                            </StackPane.margin>
                        </Button>
                    </children>
                </StackPane>
                <Label styleClass="etiqueta-campo" text="Nombre" />
                <TextField fx:id="txtNombre" accessibleText="Nombre del plato" promptText="Ej: Rabo de toro" />
                <Label styleClass="etiqueta-campo" text="Categoría" />
                <ComboBox fx:id="cmbCategoria" accessibleText="Categoría del plato" maxWidth="Infinity" promptText="Elige una categoría" />
                <Label styleClass="etiqueta-campo" text="Precio (€)" />
                <TextField fx:id="txtPrecio" accessibleText="Precio del plato en euros" promptText="Ej: 15,50">
                    <tooltip>
                        <Tooltip text="Puedes usar coma o punto para los céntimos" />
                    </tooltip>
                </TextField>
                <Label styleClass="etiqueta-campo" text="Descripción" />
                <TextArea fx:id="txtDescripcion" accessibleText="Descripción del plato" prefRowCount="3" promptText="Ingredientes o cómo se sirve" wrapText="true" />
                <CheckBox fx:id="chkDisponible" accessibleText="Plato disponible en la carta" mnemonicParsing="false" selected="true" text="Disponible en la carta">
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                </CheckBox>
                <Label fx:id="lblError" managed="false" maxWidth="Infinity" styleClass="mensaje-error" visible="false" wrapText="true" />
                <Region VBox.vgrow="ALWAYS" />
                <HBox spacing="8.0">
                    <children>
                        <Button fx:id="btnGuardar" accessibleText="Guardar el plato" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#guardar" styleClass="boton-principal" text="Guardar" HBox.hgrow="ALWAYS" />
                        <Button accessibleText="Vaciar el formulario" mnemonicParsing="false" onAction="#limpiar" styleClass="boton-secundario" text="Limpiar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>
