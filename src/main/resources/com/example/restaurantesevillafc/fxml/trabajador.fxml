<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" styleClass="fondo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantesevillafc.controller.TrabajadorController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="Archivo">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
                        <MenuItem accelerator="Shortcut+Q" mnemonicParsing="false" onAction="#salir" text="Salir" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Ver">
                    <items>
                        <MenuItem accelerator="Shortcut+1" mnemonicParsing="false" onAction="#mostrarMenu" text="Menú" />
                        <MenuItem accelerator="Shortcut+2" mnemonicParsing="false" onAction="#mostrarReservas" text="Reservas" />
                        <MenuItem accelerator="Shortcut+3" mnemonicParsing="false" onAction="#mostrarPedidos" text="Pedidos" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Ayuda">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#acercaDe" text="Acerca de" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <left>
        <VBox prefWidth="200.0" spacing="6.0" styleClass="barra-lateral" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="16.0" left="14.0" right="14.0" top="18.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <StackPane styleClass="logo">
                            <children>
                                <Label styleClass="logo-texto" text="SF" />
                            </children>
                        </StackPane>
                        <VBox>
                            <children>
                                <Label styleClass="marca-clara" text="Sevilla FC" />
                                <Label styleClass="marca-sub-clara" text="RESTAURANTE" />
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </HBox>
                <Label styleClass="titulo-seccion-lateral" text="GESTIÓN" />
                <ToggleButton fx:id="btnMenu" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarMenu" selected="true" styleClass="boton-lateral" text="Menú">
                    <toggleGroup>
                        <ToggleGroup fx:id="grupoSecciones" />
                    </toggleGroup>
                    <tooltip>
                        <Tooltip text="Añadir, modificar o eliminar platos (Ctrl+1)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="btnReservas" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarReservas" styleClass="boton-lateral" text="Reservas" toggleGroup="$grupoSecciones">
                    <tooltip>
                        <Tooltip text="Confirmar o cancelar reservas (Ctrl+2)" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="btnPedidos" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarPedidos" styleClass="boton-lateral" text="Pedidos" toggleGroup="$grupoSecciones">
                    <tooltip>
                        <Tooltip text="Pedidos en curso y finalizados (Ctrl+3)" />
                    </tooltip>
                </ToggleButton>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="caja-usuario">
                    <children>
                        <StackPane styleClass="avatar">
                            <children>
                                <Label fx:id="lblInicial" styleClass="avatar-texto" text="A" />
                            </children>
                        </StackPane>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblNombreUsuario" styleClass="marca-clara" text="Trabajador" />
                                <Label styleClass="marca-sub-clara" text="Trabajador" />
                            </children>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#cerrarSesion" styleClass="boton-salir" text="⏻">
                            <tooltip>
                                <Tooltip text="Cerrar sesión" />
                            </tooltip>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contenido" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
