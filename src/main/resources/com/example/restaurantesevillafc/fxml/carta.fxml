<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" styleClass="fondo" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurantesevillafc.controller.CartaController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <MenuBar>
                    <menus>
                        <Menu mnemonicParsing="false" text="Archivo">
                            <items>
                                <MenuItem fx:id="itemSalir" accelerator="Shortcut+Q" mnemonicParsing="false" text="Salir" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Ayuda">
                            <items>
                                <MenuItem fx:id="itemAcercaDe" mnemonicParsing="false" text="Acerca de" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="barra-cliente">
                    <padding>
                        <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
                    </padding>
                    <children>
                        <StackPane styleClass="logo">
                            <children>
                                <Label styleClass="logo-texto" text="SF" />
                            </children>
                        </StackPane>
                        <VBox>
                            <children>
                                <Label styleClass="marca" text="Sevilla FC" />
                                <Label styleClass="marca-sub" text="RESTAURANTE" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button fx:id="btnCarta" mnemonicParsing="false" text="Carta">
                                    <styleClass>
                                        <String fx:value="nav-boton" />
                                        <String fx:value="nav-boton-activo" />
                                    </styleClass>
                                </Button>
                                <Button fx:id="btnMiPedido" contentDisplay="RIGHT" graphicTextGap="8.0" mnemonicParsing="false" styleClass="nav-boton" text="Mi pedido">
                                    <graphic>
                                        <Label fx:id="lblNumPlatos" styleClass="badge" text="0" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Ver los platos que has añadido y confirmar el pedido" />
                                    </tooltip>
                                </Button>
                                <Button fx:id="btnReservar" mnemonicParsing="false" styleClass="nav-boton" text="Reservar mesa">
                                    <tooltip>
                                        <Tooltip text="Reservar una mesa en el restaurante" />
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="avatar">
                            <children>
                                <Label fx:id="lblInicial" styleClass="avatar-texto" text="L" />
                            </children>
                        </StackPane>
                        <VBox>
                            <children>
                                <Label fx:id="lblSaludo" styleClass="saludo" text="Hola, Lucía" />
                                <Label styleClass="marca-sub" text="Cliente" />
                            </children>
                        </VBox>
                        <Button fx:id="btnCerrarSesion" mnemonicParsing="false" styleClass="boton-secundario" text="Salir">
                            <tooltip>
                                <Tooltip text="Cerrar sesión" />
                            </tooltip>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <left>
        <VBox prefWidth="190.0" spacing="6.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="10.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="etiqueta-seccion" text="CATEGORÍAS" />
                <ToggleButton fx:id="btnTodos" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" selected="true" styleClass="boton-categoria" text="Todos">
                    <toggleGroup>
                        <ToggleGroup fx:id="grupoCategoria" />
                    </toggleGroup>
                    <tooltip>
                        <Tooltip text="Ver todos los platos" />
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="btnEntrantes" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" styleClass="boton-categoria" text="Entrantes" toggleGroup="$grupoCategoria" />
                <ToggleButton fx:id="btnPrincipales" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" styleClass="boton-categoria" text="Principales" toggleGroup="$grupoCategoria" />
                <ToggleButton fx:id="btnPostres" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" styleClass="boton-categoria" text="Postres" toggleGroup="$grupoCategoria" />
                <ToggleButton fx:id="btnBebidas" alignment="CENTER_LEFT" maxWidth="Infinity" mnemonicParsing="false" styleClass="boton-categoria" text="Bebidas" toggleGroup="$grupoCategoria" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="24.0" left="14.0" right="32.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="titulo-pagina" text="Nuestra carta" />
                                <Label styleClass="subtitulo" text="Cocina tradicional sevillana, hecha cada día con producto de mercado." />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtBuscar" prefWidth="230.0" promptText="Buscar plato...">
                            <tooltip>
                                <Tooltip text="Escribe el nombre de un plato para encontrarlo" />
                            </tooltip>
                        </TextField>
                    </children>
                </HBox>
                <TableView fx:id="tablaCarta" fixedCellSize="64.0" styleClass="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPlato" prefWidth="280.0" text="PLATO" />
                        <TableColumn fx:id="colCategoria" prefWidth="110.0" text="CATEGORÍA" />
                        <TableColumn fx:id="colAlergenos" prefWidth="150.0" text="ALÉRGENOS" />
                        <TableColumn fx:id="colPrecio" prefWidth="80.0" text="PRECIO" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="contador" text="Selecciona un plato y pulsa Añadir al pedido." />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblAnadido" managed="false" styleClass="mensaje-ok" visible="false" />
                        <Button fx:id="btnAnadir" mnemonicParsing="false" styleClass="boton-principal" text="Añadir al pedido">
                            <tooltip>
                                <Tooltip text="Añadir una unidad del plato seleccionado a tu pedido" />
                            </tooltip>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
